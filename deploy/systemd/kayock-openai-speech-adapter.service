[Unit]
Description=Kayock OpenAI-compatible Speech Adapter (Read Aloud)
After=network-online.target kayock-voice.service
Wants=network-online.target
Requires=kayock-voice.service

[Service]
Type=simple
User=kayock
Group=kayock
WorkingDirectory=/opt/kayock-voice/openai-speech-adapter
Environment=KAYOCK_SPEAK_URL=https://127.0.0.1:8766/speak
Environment=KAYOCK_VOICES_URL=https://127.0.0.1:8766/voices
Environment=KAYOCK_HEALTH_URL=https://127.0.0.1:8766/health
Environment=KAYOCK_SPEAK_TIMEOUT_SECONDS=600
ExecStart=/opt/kayock-voice/kokoro/.venv/bin/uvicorn adapter:app --host 0.0.0.0 --port 8768
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
